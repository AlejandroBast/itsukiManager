{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ItsukiManager",
  "version": "1.1.0",
  "identifier": "com.itsukimanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ItsukiManager",
        "width": 1087,
        "height": 612,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "visible": false,
        "center": true,
        "backgroundColor": "#211319"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
